# Secrets para Streamlit Community Cloud (App settings -> Secrets). NO subir el archivo real con la clave.
# Las claves de nivel raíz se exponen como variables de entorno, que es lo que lee la app.
LLM_API_KEY = "gsk_..."
LLM_BASE_URL = "https://api.groq.com/openai/v1"
LLM_MODEL = "llama-3.3-70b-versatile"
AGENT_T_MAX = "6"
# Despliegue con 1 GB de RAM: red desde data/ y RAG con TF-IDF
OSM_SOURCE = "snapshot"
RAG_BACKEND = "tfidf"
