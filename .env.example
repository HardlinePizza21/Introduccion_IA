# Copie este archivo como .env y complete su clave. Cualquier endpoint compatible con OpenAI sirve.
# Groq (capa gratuita): https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM:
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.3-70b-instruct
# Ollama local (sin clave; el modelo debe soportar tool calling):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# Máximo de iteraciones del loop del agente
AGENT_T_MAX=6
# Embeddings del RAG: fastembed (por defecto) o tfidf (sin descargas)
RAG_BACKEND=fastembed
